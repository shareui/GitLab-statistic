[ Telegram Bot Configuration ]

telegram :: class {
    bot_token :: str { "telegram_bot_token" }
    target_channel_id :: num { 0 } [ channel bot api id ]
}

[ GitLab Configuration ]

gitlab :: class {
    private_token :: str { "GITLAB_PRIVATE_TOKEN" }
    target_username :: str { "GITLAB_USERNAME" }
}

[ Scheduler Configuration ]

scheduler :: class {
    interval_hours :: num { 1 } [ Check interval in hours ]
}

[ Health Check Configuration ]

health_check :: class {
    port :: num { 8000 }
}

[ Display Settings ]

display :: class {
    max_displayed_languages :: num { 10 }
    quote :: bool { true } [ Use quote formatting for languages list ]
    force_message_id :: num { 43 } [ Set to 0 to disable forced message editing ]
}

[ Processing Limits ]

limits :: class {
    max_file_lines :: num { 10000 } [ Maximum lines to process per file ]
}

